# Variables from the environment: PRIMARY_URL (the main server's dashboard) and STANDBY_STATUS_URL (this server's Stratum).
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;

  set $primary "${PRIMARY_URL}";
  set $standby_status "${STANDBY_STATUS_URL}";

  # What this backup server is doing (rigs connected, records waiting), for the offline page.
  location = /standby/status.json {
    proxy_pass $standby_status/status;
    proxy_connect_timeout 1s;
    proxy_read_timeout 3s;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    error_page 502 503 504 = @status_unavailable;
  }
  location @status_unavailable {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 503 '{"ok":false,"reason":"this server is not answering"}';
  }

  # Is the main server's dashboard reachable? The offline page asks, and reloads when it is.
  location = /standby/primary {
    proxy_pass $primary/api/v1/version;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3s;
    add_header Cache-Control "no-store" always;
    error_page 502 503 504 = @primary_down;
  }
  location @primary_down {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 503 '{"error":"primary_unreachable"}';
  }

  # The dashboard's data: while the main server is away it answers like a database that is not reachable.
  location /api/ {
    proxy_pass $primary;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 2s;
    proxy_read_timeout 3600s;
    client_max_body_size 0;
    proxy_intercept_errors on;
    error_page 502 503 504 = @api_unavailable;
  }
  location @api_unavailable {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 503 '{"error":"dependency_unavailable"}';
  }

  # The dashboard itself: the main server's, or the offline page.
  location / {
    proxy_pass $primary;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 60s;
    proxy_intercept_errors on;
    error_page 502 503 504 = @offline;
  }
  location @offline {
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # The offline page has one inline script of its own and talks only to itself.
    add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    rewrite ^ /offline.html break;
  }
  location = /offline.html {
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
  }
}
