# Network: mainnet, testnet, or devnet. Devnet is intended for local development.
XELIS_NETWORK=devnet
XELIS_DAEMON_IMAGE=xelis/daemon:latest
XELIS_P2P_BIND_IP=127.0.0.1
XELIS_P2P_PORT=2125
XELDASH_API_BIND_IP=127.0.0.1
XELDASH_API_PORT=8081
STRATUM_HANDSHAKE_TIMEOUT_MS=10000
STRATUM_MAX_QUEUED_REQUESTS=32

# The default miner address must be valid for the selected network.
XELIS_DEFAULT_ADDRESS=
XELIS_RPC_URL=http://daemon:8080/json_rpc

POSTGRES_DB=xeldash
POSTGRES_USER=xeldash
# Replace before starting Compose. Do not commit your .env file.
POSTGRES_PASSWORD=
