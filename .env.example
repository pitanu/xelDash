# Released images: set a version (for example 0.1.0) and run `docker compose pull`.
# The default, local, builds from source.
XELDASH_VERSION=local
XELDASH_IMAGE_REGISTRY=ghcr.io/pitanu/xeldash

# Network: mainnet, testnet, or devnet. Devnet is intended for local development.
XELIS_NETWORK=devnet
# Tested release; mainnet needs 1.24.0 or newer. The binary is re-based onto Debian 13,
# see docker/daemon/README.md.
XELIS_DAEMON_IMAGE=xelis/daemon:1.25.0
XELIS_P2P_BIND_IP=127.0.0.1
XELIS_P2P_PORT=2125
XELDASH_API_BIND_IP=127.0.0.1
XELDASH_API_PORT=8081
XELDASH_WEB_BIND_IP=127.0.0.1
XELDASH_WEB_PORT=8088
XELDASH_STRATUM_BIND_IP=127.0.0.1
XELDASH_STRATUM_PORT=3333
# Optional TLS Stratum (stratum+ssl). Put cert.pem and key.pem in docker/stratum-tls/ or set
# XELDASH_STRATUM_TLS_DIR; see docker/stratum-tls/README.md.
STRATUM_TLS_ENABLED=false
XELDASH_STRATUM_TLS_PORT=3334
XELDASH_STRATUM_TLS_DIR=./docker/stratum-tls
# Getwork for miners without Stratum (the official xelis_miner):
# ws://<host>:8090/getwork/<address>/<worker>. Uses the same bind IP as Stratum.
GETWORK_ENABLED=true
XELDASH_GETWORK_PORT=8090
STRATUM_HANDSHAKE_TIMEOUT_MS=10000
STRATUM_MAX_QUEUED_REQUESTS=32
STRATUM_JOB_REFRESH_MS=5000
# Threads for hashing shares in parallel (libuv thread pool).
STRATUM_HASH_THREADS=8
# Vardiff: start and minimum share difficulty, target seconds per share, and a retarget
# after this many seconds or accepted shares, whichever comes first.
STRATUM_START_DIFFICULTY=100000
STRATUM_MIN_DIFFICULTY=1000
STRATUM_TARGET_SHARE_SECONDS=10
STRATUM_RETARGET_SECONDS=60
STRATUM_RETARGET_SHARES=20
# Abuse limits. An IP is banned when a window has at least BAN_INVALID_COUNT invalid
# submissions and they are more than BAN_INVALID_RATIO of its submissions. Stale shares do not
# count. Exempt IPs (comma-separated) are never banned or connection-limited.
STRATUM_MAX_CONNECTIONS_PER_IP=64
STRATUM_MESSAGES_PER_SECOND=20
STRATUM_MESSAGE_BURST=40
STRATUM_BAN_WINDOW_SECONDS=300
STRATUM_BAN_INVALID_COUNT=50
STRATUM_BAN_INVALID_RATIO=0.5
STRATUM_BAN_MINUTES=15
STRATUM_BAN_EXEMPT_IPS=

# Retention, in days. Raw shares and per-minute stats are deleted after these periods; hourly
# stats, blocks and events are kept. Stratum runs the cleanup hourly.
RETENTION_RAW_SHARE_DAYS=7
RETENTION_MINUTE_STATS_DAYS=90

# Optional alerts. Set any of Discord, Telegram (both values) or a generic JSON webhook.
# ALERT_EVENTS picks from: block_found, block_rejected, block_final, mining_paused,
# worker_offline (default: all). ALERT_DASHBOARD_URL adds links, e.g. http://192.168.1.10:8088
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_EVENTS=
ALERT_WORKER_OFFLINE_MINUTES=10
ALERT_DASHBOARD_URL=

# Optional HTTPS and login in front of the dashboard: set COMPOSE_PROFILES=proxy and the lines
# below. Keep the password hash in single quotes. See docs/OPERATIONS.md#https-and-a-login.
XELDASH_PROXY_HOST=
XELDASH_PROXY_USER=admin
XELDASH_PROXY_PASSWORD_HASH=
XELDASH_PROXY_BIND_IP=127.0.0.1
XELDASH_PROXY_PORT=8443

# Optional backups: docker compose --profile backup up -d (see docs/OPERATIONS.md).
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
XELDASH_BACKUP_DIR=./backups

# The default miner address must be valid for the selected network.
XELIS_DEFAULT_ADDRESS=

# Admin token for actions that change the node: daemon settings and snapshots (long and random,
# e.g. openssl rand -hex 24). Leave empty to keep those actions off.
XELDASH_ADMIN_TOKEN=

# Snapshots: download the official mainnet snapshot on a first start with no chain data.
# See docs/OPERATIONS.md#snapshots.
XELIS_SNAPSHOT_AUTO=false

# Nodes Stratum and the API use, in priority order (comma-separated). For a second node in
# this stack, set COMPOSE_PROFILES=redundant and add http://daemon2:8080/json_rpc; see
# docs/OPERATIONS.md#redundant-nodes. XELIS_DAEMON2_IMAGE pins daemon2 separately for
# one-at-a-time upgrades (defaults to XELIS_DAEMON_IMAGE).
XELIS_RPC_URLS=http://daemon:8080/json_rpc
# COMPOSE_PROFILES=redundant
# XELIS_DAEMON2_IMAGE=

# XEL price on the dashboard (Settings → Display), fetched by the API from CoinGecko every
# 5 minutes while someone has it on. "off" hides the option and makes no requests.
XELDASH_PRICE=on

# Mining fallback: mine through the official public node (node.xelis.io) only while none of
# the nodes above can issue work. Also switchable on the dashboard's Node page, which then
# takes precedence. See docs/OPERATIONS.md#official-node-fallback.
XELIS_OFFICIAL_FALLBACK=false
# XELIS_OFFICIAL_NODE_URL=

POSTGRES_DB=xeldash
POSTGRES_USER=xeldash
# Replace before starting Compose. Do not commit your .env file.
POSTGRES_PASSWORD=
