{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["services/**/*.ts", "services/**/*.js", "packages/**/*.js"],
  "exclude": ["node_modules", "dist", "services/**/test/**", "packages/**/test/**"]
}
